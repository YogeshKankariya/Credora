# Server
PORT=5000
NODE_ENV=development

# Database
# Matches the local PostgreSQL service in ../docker-compose.yml.
# This password is for local development/testing only.
DATABASE_URL="postgresql://postgres:hack2ignite_local_dev@localhost:5432/kyc_db?schema=public"

# Authentication
# Development-only example secret. Use a strong secret outside local testing.
JWT_SECRET="hack2ignite_local_development_jwt_secret"
JWT_EXPIRES_IN="7d"

# Google OAuth Configuration (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Frontend
CLIENT_URL="http://localhost:5173"

# Blockchain (fill in when ready)
BLOCKCHAIN_RPC_URL=""
BLOCKCHAIN_PRIVATE_KEY=""
KYC_REGISTRY_ADDRESS=""
BLOCKCHAIN_NETWORK="localhost"

# Issuer Cryptography (fill in when ready)
ISSUER_PRIVATE_KEY=""
ISSUER_PUBLIC_KEY=""
